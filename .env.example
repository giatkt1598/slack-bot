SLACK_BOT_TOKEN=xoxb-your-token
SLACK_APP_TOKEN=xapp-your-app-level-token
# SQLite job history; the single-instance lock file is created next to it.
DATABASE_PATH=./data/slack-bot.sqlite
# Default runtime limit per command (time waiting for user input is not counted).
COMMAND_TIMEOUT_MS=1800000
# How long a command may wait for a user's answer to a prompt before it is killed.
INPUT_TIMEOUT_MS=1800000
AUTHORIZED_CHANNEL_IDS=
AUTHORIZED_USER_IDS=
LOG_LEVEL=info
