{
  "name": "slack-command-runner",
  "version": "1.0.0",
  "private": true,
  "description": "Slack command bot that queues and runs allowlisted commands on a Windows host",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "start": "node src/index.ts",
    "typecheck": "tsc",
    "test": "node --test \"test/**/*.test.ts\""
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@slack/bolt": "^5.1.0",
    "cross-spawn": "^7.0.6",
    "dotenv": "^18.0.8",
    "sql.js": "^1.15.0"
  },
  "devDependencies": {
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^24.19.2",
    "@types/sql.js": "^1.4.11",
    "typescript": "^7.0.2"
  }
}
